# Keep the Docker build context small and free of local-only files.
.git
.gitignore

# Python
.venv
**/__pycache__
*.pyc

# Node / frontend
**/node_modules
frontend/dist

# Local data not needed in images
dataset
uploads

# Editor / OS
.idea
.vscode
.DS_Store

# Local env files (real secrets); keep the examples
**/.env
**/.env.*
!**/.env.example
